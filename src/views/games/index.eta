<% layout('../layouts/base') %>

<div class="page-header">
  <h1 class="page-header__title">My Games</h1>
  <a href="/games/new" class="btn btn--gold">+ Add a Game</a>
</div>

<% if (it.joined && it.joined.length) { %>
<%/* Sessions someone else hosts that you joined through an invite; first, so a game in progress is one tap away */%>
<section aria-labelledby="joined-heading" class="section" style="margin-bottom:var(--space-6)">
  <h2 id="joined-heading" style="margin-bottom:var(--space-3)">Games you've joined</h2>
  <ul role="list" style="list-style:none;display:grid;gap:var(--space-2)">
    <% it.joined.forEach(function(j) { %>
    <li>
      <a href="/games/<%= j.game_id %>/sessions/<%= j.id %>" class="card session-card"
         style="display:flex;align-items:center;gap:var(--space-3);text-decoration:none;padding:var(--space-2) var(--space-3)">
        <span style="flex:1;min-width:0">
          <span style="display:block;font-weight:600"><%= j.game_name %></span>
          <span style="font-size:var(--text-sm);color:var(--color-text-muted)">
            <%= j.host_name ? 'Hosted by ' + j.host_name + ' · ' : '' %><%= new Date(j.completed_at || j.started_at).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %>
          </span>
        </span>
        <span class="badge badge--<%= j.status === 'active' ? 'active' : 'complete' %>"><%= j.status === 'active' ? 'Playing now' : 'Finished' %></span>
      </a>
    </li>
    <% }) %>
  </ul>
</section>
<% } %>

<% if (it.games.length === 0) { %>
<div class="empty-state">
  <span class="empty-state__icon" aria-hidden="true">🎲</span>
  <h2 class="empty-state__title"><%= it.joined && it.joined.length ? 'No games of your own yet' : 'No games yet' %></h2>
  <p style="margin-bottom:var(--space-4)">Add your first game to start tracking sessions and scores.</p>
  <a href="/games/new" class="btn btn--primary">Add a Game</a>
</div>
<% } else { %>
<%~ include('../partials/game-list', it) %>
<% } %>
