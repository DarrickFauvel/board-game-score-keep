<% layout('../layouts/base') %>

<div class="page-header">
  <div class="page-header__text">
  <a href="/games" class="page-header__eyebrow"><span aria-hidden="true">←</span> Games</a>
  <%/* The thumbnail from the games list, beside the title; it travels here
       from the list on a page transition (base.css, main.js) */%>
  <div class="game-title">
    <% if (it.game.image_url) { %>
    <div class="game-title__thumb game-cover" data-vt aria-hidden="true"
         style="--cover-bg: url('<%= it.imgUrl(it.game.image_url) %>'); --vt: game-<%= it.game.id %>">
      <img class="game-cover__img" src="<%= it.imgUrl(it.game.image_url) %>" alt="">
    </div>
    <% } %>
    <h1 class="page-header__title" data-vt style="--vt: game-name-<%= it.game.id %>; view-transition-class: game-name"><%= it.game.name %></h1>
  </div>
  </div>
  <div class="page-header__actions">
    <a href="/games/<%= it.game.id %>/sessions/new" class="btn btn--gold">+ New session</a>
    <a href="/standings?game=<%= it.game.id %>" class="btn btn--secondary">Standings</a>
    <% if (it.canManageGames) { %>
    <a href="/games/<%= it.game.id %>/edit" class="btn btn--secondary">Edit game</a>
    <% } %>
  </div>
</div>

<%/* Sessions are the page's main column; the cover, how it plays and
     copying sit beside them from laptops up, and under them on phones */%>
<div class="game-page">
  <div class="game-page__main">
  <section aria-labelledby="sessions-heading">
    <div class="section-head"><h2 id="sessions-heading">Session history</h2></div>

    <% if (it.sessions.length === 0) { %>
    <div class="empty-state">
      <h3 class="empty-state__title">No sessions yet</h3>
      <p style="margin-bottom:var(--space-3)">Play it once and every round lands here.</p>
      <a href="/games/<%= it.game.id %>/sessions/new" class="btn btn--primary">Start the first session</a>
    </div>
    <% } else { %>
    <div class="stack" role="list">
      <% it.sessions.forEach(function(session) { %>
      <a class="link-card" role="listitem"
         href="/games/<%= it.game.id %>/sessions/<%= session.id %>"
         aria-label="Session from <%= new Date(session.started_at).toLocaleDateString() %>, <%= session.status %>">
        <span class="link-card__text">
          <span class="link-card__title"><%= new Date(session.started_at).toLocaleDateString('en-US', {weekday:'short', month:'short', day:'numeric', year:'numeric'}) %></span>
          <span class="link-card__meta"><%= session.participant_count %> player<%= session.participant_count !== 1 ? 's' : '' %></span>
        </span>
        <span class="badge badge--<%= session.status === 'active' ? 'active' : 'complete' %>"><%= session.status === 'active' ? 'Active' : 'Completed' %></span>
      </a>
      <% }) %>
    </div>
    <% } %>
  </section>
  </div>

  <aside class="game-page__aside" aria-label="About <%= it.game.name %>">
  <% if (it.game.image_url) { %>
  <game-image src="<%= it.imgUrl(it.game.image_url) %>" alt="<%= it.game.name %>" max-height="16rem" class="game-aside__cover"></game-image>
  <% } %>

  <section aria-labelledby="details-heading" class="card">
    <div class="card__body">
      <h2 id="details-heading" class="card__heading">How it plays</h2>
      <dl class="details-list">
        <dt>Scoring</dt>
        <dd><%= it.game.scoring_mode === 'tally' ? 'Running tally' : it.game.scoring_mode === 'final' ? 'Final score' : 'Custom categories' %></dd>
        <% const u = it.units(it.game) %>
        <% if (it.game.scoring_mode === 'tally' && it.game.suggested_rounds) { %>
        <dt><%= u.Rounds %></dt>
        <dd><%= it.game.suggested_rounds %> per game</dd>
        <% } %>
        <% const lowestWins = it.winRule(it.game).lowestWins %>
        <dt>Winner</dt>
        <dd><%= lowestWins ? 'Lowest score' : 'Highest score' %></dd>
        <% if (it.game.target_score) { %>
        <dt><%= lowestWins ? 'Game ends' : 'To win' %></dt>
        <dd><%= lowestWins ? 'When someone reaches' : 'First to' %> <%= u.pointCount(Number(it.game.target_score)) %></dd>
        <% } %>
        <dt>Teams</dt>
        <dd><%= it.game.teams_mode === 'none' ? 'Individual players' : it.game.teams_mode === 'adhoc' ? 'Ad-hoc teams' : 'Profile-linked teams' %></dd>
        <% if (it.game.rules_url || it.game.rules_video_url || it.game.bgg_url) { %>
        <dt>Rules &amp; info</dt>
        <dd class="link-list">
          <% if (it.game.rules_url) { %><a href="<%= it.game.rules_url %>" target="_blank" rel="noopener noreferrer external">Read the rules<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span></a><% } %>
          <% if (it.game.rules_video_url) { %><a href="<%= it.game.rules_video_url %>" target="_blank" rel="noopener noreferrer external">Watch how to play<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span></a><% } %>
          <% if (it.game.bgg_url) { %><a href="<%= it.game.bgg_url %>" target="_blank" rel="noopener noreferrer external">View on BoardGameGeek<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span></a><% } %>
        </dd>
        <% } %>
        <% if (it.categories.length > 0) { %>
        <dt>Categories</dt>
        <dd><%= it.categories.map(c => c.name).join(', ') %></dd>
        <% } %>
      </dl>
    </div>
  </section>

  <%/* Only for people in another group where they can add games */%>
  <% if (it.copyTargets.length) { %>
  <section aria-labelledby="copy-heading" class="card" id="copy">
    <div class="card__body">
      <h2 id="copy-heading" class="card__heading">Copy to another group</h2>
      <p class="form-hint" id="copy-hint" style="margin-bottom:var(--space-2)">
        Copies the game's settings: scoring, <%= it.units(it.game).rounds %>, categories, colors and links. Sessions and scores stay here.<% if (it.game.teams_mode === 'profiles') { %> Teams aren't copied, so set them up again in the other group.<% } %>
      </p>
      <% if (it.copyError) { %><div class="flash flash--error" role="alert" style="margin-bottom:var(--space-2)"><%= it.copyError %></div><% } %>
      <form action="/games/<%= it.game.id %>/copy" method="POST" style="display:flex;flex-wrap:wrap;gap:var(--space-2);align-items:end">
        <div style="flex:1 1 14rem">
          <label class="form-label" for="copy-group">Group</label>
          <select class="form-control" id="copy-group" name="group_id" aria-describedby="copy-hint">
            <% it.copyTargets.forEach(function(g) { %><option value="<%= g.id %>"><%= g.name %></option><% }) %>
          </select>
        </div>
        <button type="submit" class="btn btn--secondary">Copy game</button>
      </form>
    </div>
  </section>
  <% } %>
  </aside>
</div>
