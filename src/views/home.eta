<% layout('layouts/base') %>
<% const winsText = (n) => n + ' ' + (n === 1 ? 'win' : 'wins') %>
<% const names = (list) => list.map((p) => p.name).join(' & ') %>

<div class="page-header">
  <div class="page-header__text">
    <% if (it.group) { %><p class="page-header__eyebrow"><%= it.group.name %></p><% } %>
    <h1 class="page-header__title" id="fame-heading">Hall of fame</h1>
    <p class="page-header__lede">Every win and loss your group has played, kept in one place.</p>
  </div>
  <% if (it.hall.podium.length) { %>
  <div class="page-header__actions">
    <a href="/standings" class="btn btn--secondary">Full standings</a>
  </div>
  <% } %>
</div>

<% if (it.games.length === 0) { %>
<div class="empty-state">
  <span class="empty-state__icon"><%~ it.icon('keep') %></span>
  <h2 class="empty-state__title">No games yet</h2>
  <p style="margin-bottom:var(--space-4)">Add a board game, play a session, and the winners go up on the wall.</p>
  <a href="/games/new" class="btn btn--gold">Add your first game</a>
</div>

<% } else if (it.hall.podium.length === 0) { %>
<div class="empty-state">
  <span class="empty-state__icon"><%~ it.icon('trophy') %></span>
  <h2 class="empty-state__title">No champions yet</h2>
  <p style="margin-bottom:var(--space-4)">Finish a game with two or more players and the first name goes up on the wall.</p>
  <a href="/games" class="btn btn--primary">Start a session</a>
</div>

<% } else { %>
<%/* DOM order is 1st, 2nd, 3rd for screen readers; CSS stands them 2–1–3,
     and closes up when there are only one or two */%>
<div class="podium-panel">
  <ol class="podium podium--<%= it.hall.podium.length %>" role="list" aria-labelledby="fame-heading">
    <% it.hall.podium.forEach(function(s, i) { %>
    <li class="podium__place podium__place--<%= i + 1 %>">
      <%~ it.avatar(s.avatarUrl, s.name, s.color, 'podium__avatar') %>
      <span class="podium__name"><span class="visually-hidden">Rank <%= s.rank %>: </span><%= s.name %></span>
      <span class="podium__wins"><%= winsText(s.wins) %></span>
      <span class="podium__step<%= s.rank === 1 ? ' podium__step--gold' : '' %>" aria-hidden="true"><%= s.rank %></span>
    </li>
    <% }) %>
  </ol>
</div>

<div class="hall-cards">
  <% if (it.hall.champions.length) { %>
  <section class="card hall-card" aria-labelledby="champions-heading">
    <h2 class="hall-card__title" id="champions-heading">Game champions</h2>
    <ul class="hall-card__list" role="list">
      <% it.hall.champions.forEach(function(c) { %>
      <li>
        <a href="/standings?game=<%= c.gameId %>" class="hall-row">
          <span class="avatar-stack"><% c.leaders.forEach(function(l) { %><%~ it.avatar(l.avatarUrl, l.name, l.color, 'avatar--sm') %><% }) %></span>
          <span class="hall-row__text">
            <span class="hall-row__title"><%= c.gameName %></span>
            <span class="hall-row__meta"><%~ it.icon('crown', 'hall-row__icon') %><%= names(c.leaders) %> · <%= winsText(c.leaders[0].wins) %></span>
          </span>
        </a>
      </li>
      <% }) %>
    </ul>
  </section>
  <% } %>

  <% if (it.hall.victories.length) { %>
  <section class="card hall-card" aria-labelledby="victories-heading">
    <h2 class="hall-card__title" id="victories-heading">Latest victories</h2>
    <ul class="hall-card__list" role="list">
      <% it.hall.victories.forEach(function(v) { %>
      <li>
        <a href="/games/<%= v.gameId %>/sessions/<%= v.sessionId %>" class="hall-row">
          <span class="avatar-stack"><% v.winners.forEach(function(w) { %><%~ it.avatar(w.avatarUrl, w.name, w.color, 'avatar--sm') %><% }) %></span>
          <span class="hall-row__text">
            <span class="hall-row__title"><%= names(v.winners) %> <%= v.winners.length > 1 ? 'tied' : 'won' %> <%= v.gameName %></span>
            <span class="hall-row__meta"><%~ it.icon('trophy', 'hall-row__icon') %><%= new Date(v.completedAt).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %></span>
          </span>
        </a>
      </li>
      <% }) %>
    </ul>
  </section>
  <% } %>
</div>
<% } %>
