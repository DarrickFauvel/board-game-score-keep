<%/* The group's games: compact rows on phones, cover cards from tablets up.
     The cover or name opens the game; "+ Session" starts one. Expects
     it.games (with last_played_at and active_sessions) and it.imgUrl. */%>
<% const scoring = { tally: 'Running tally', final: 'Final score', categories: 'Categories' } %>
<ul class="game-list" role="list">
  <% it.games.forEach(function(game) { %>
  <% const playing = Number(game.active_sessions) > 0 %>
  <li class="game-row">
    <a class="game-row__main" href="/games/<%= game.id %>">
      <% if (game.image_url) { %>
      <div class="game-row__thumb game-cover" data-vt style="--cover-bg: url('<%= it.imgUrl(game.image_url) %>'); --vt: game-<%= game.id %>">
        <img class="game-cover__img" src="<%= it.imgUrl(game.image_url) %>" alt="" loading="lazy">
      </div>
      <% } else { %>
      <div class="game-row__thumb game-row__thumb--empty" aria-hidden="true"><%~ it.icon('dice') %></div>
      <% } %>
      <span class="game-row__text">
        <span class="game-row__name" data-vt style="--vt: game-name-<%= game.id %>; view-transition-class: game-name"><%= game.name %></span>
        <span class="game-row__meta">
          <% if (playing) { %>
          <span class="badge badge--active">Playing now</span>
          <% } else if (game.last_played_at) { %>
          <span>Played <%= new Date(game.last_played_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
          <% } else { %>
          <span>Not played yet</span>
          <% } %>
          <span class="game-row__mode"><%= scoring[game.scoring_mode] || '' %><% if (game.teams_mode !== 'none') { %> · Teams<% } %></span>
        </span>
      </span>
    </a>
    <a href="/games/<%= game.id %>/sessions/new" class="btn btn--secondary btn--sm game-row__action"
       aria-label="Start new session of <%= game.name %>"><span aria-hidden="true">+</span><span class="game-row__action-label" aria-hidden="true">Session</span></a>
  </li>
  <% }) %>
</ul>
