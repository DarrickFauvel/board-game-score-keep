<% layout('../layouts/base') %>

<div style="max-width:36rem;margin:0 auto">
  <div class="page-header">
    <h1 class="page-header__title">Edit Profile</h1>
    <a href="/players/<%= it.player.id %>" class="btn btn--secondary">Cancel</a>
  </div>

  <% if (it.error) { %>
  <div class="flash flash--error" role="alert"><%= it.error %></div>
  <% } %>

  <form action="/players/<%= it.player.id %>" method="POST" enctype="multipart/form-data" novalidate>

    <fieldset class="form-group" style="border:0;padding:0;margin-inline:0">
      <legend class="form-label">Profile picture</legend>
      <div style="display:flex;align-items:center;gap:var(--space-3);margin-bottom:var(--space-3)">
        <%~ it.avatar(it.player.avatar_url, it.player.display_name, it.player.preferred_color, 'avatar--lg', it.player.avatar_url ? 'Your current profile picture' : '') %>
        <% if (it.player.avatar_url) { %>
        <label style="display:inline-flex;align-items:center;gap:var(--space-2);min-height:3rem;cursor:pointer">
          <input type="checkbox" name="remove_avatar" value="1"> Remove picture
        </label>
        <% } else { %>
        <span class="form-hint" style="margin:0">No picture yet. Others see your initial until you add one.</span>
        <% } %>
      </div>
      <avatar-picker name="avatar" facing="user" aria-label="Upload, link or take a new profile picture"></avatar-picker>
      <span class="form-hint">JPEG, PNG, WebP, GIF or AVIF, up to 10 MB.</span>

      <%/* The cropper shows the picture being framed, so the picker's own thumbnails would repeat it */%>
      <style>avatar-picker .ap-preview { display: none !important; }</style>
      <div style="margin-top:var(--space-4)">
        <span class="form-label" style="display:block">Framing</span>
        <avatar-cropper name="avatar_crop"
          <% if (it.player.avatar_url) { %>src="<%= it.imgOriginal(it.player.avatar_url) %>" crop="<%= it.imgCrop(it.player.avatar_url) %>"<% } %>></avatar-cropper>
      </div>
    </fieldset>

    <div class="form-group">
      <label class="form-label" for="display_name">
        Display name <span class="required" aria-hidden="true">*</span>
      </label>
      <input class="form-control" type="text" id="display_name" name="display_name"
             value="<%= it.player.display_name %>" required aria-required="true" maxlength="60">
    </div>

    <div class="form-group">
      <label class="form-label" for="preferred_token">Personal token / emoji</label>
      <input class="form-control" type="text" id="preferred_token" name="preferred_token"
             value="<%= it.player.preferred_token || '' %>" maxlength="10"
             placeholder="e.g. ♟ or 🎩 or Blue"
             aria-describedby="token-hint">
      <span class="form-hint" id="token-hint">A short symbol, emoji, or color that represents you on score sheets.</span>
    </div>

    <div class="form-group">
      <label class="form-label" for="preferred_color">Preferred color</label>
      <div class="color-field">
        <input type="color" id="preferred_color" name="preferred_color"
               value="<%= it.player.preferred_color || '#5a3e2b' %>"
               aria-describedby="color-hint">
        <input class="form-control" type="text" value="<%= it.player.preferred_color || '#5a3e2b' %>"
               style="flex:1" oninput="document.getElementById('preferred_color').value=this.value">
      </div>
      <span class="form-hint" id="color-hint">Used for your player chip and score sheet highlights.</span>
    </div>

    <div class="form-actions">
      <a href="/players/<%= it.player.id %>" class="btn btn--secondary">Cancel</a>
      <button type="submit" class="btn btn--primary">Save Profile</button>
    </div>

  </form>
</div>
