<% layout('../layouts/base') %>
<% const isGuest = !it.player.user_id; %>

<div style="max-width:36rem;margin:0 auto">
  <div class="page-header">
    <h1 class="page-header__title"><%= it.title %></h1>
    <a href="/players/<%= it.player.id %>" class="btn btn--secondary">Done</a>
  </div>
  <p class="form-hint autosave-note">Name and color save automatically. A new picture saves with its own button.</p>

  <% if (it.error) { %>
  <div class="flash flash--error" role="alert"><%= it.error %></div>
  <% } %>

  <%/* Name and color save as they change; the button is only for browsers without JavaScript */%>
  <% const detailsUrl = `/players/${it.player.id}/details` %>
  <form action="<%= detailsUrl %>" method="POST" novalidate data-autosave
        data-on:submit__prevent="@post('<%= detailsUrl %>?field=name', {contentType: 'form'})">
    <div class="form-group">
      <label class="form-label" for="display_name">
        <%= isGuest ? 'Name' : 'Display name' %> <span class="required" aria-hidden="true">*</span>
      </label>
      <div class="autosave">
        <input class="form-control" type="text" id="display_name" name="display_name"
               value="<%= it.player.display_name %>" aria-required="true" maxlength="60"
               aria-describedby="save-name-error"
               data-on:input__debounce.800ms="@post('<%= detailsUrl %>?field=name', {contentType: 'form'})">
        <span id="save-name" class="autosave__mark" aria-hidden="true"></span>
      </div>
      <span id="save-name-error" class="form-error"></span>
    </div>

    <%/* $openedColor is the color when the page opened. Colors save as you
         pick them, so a wrong pick is already saved: once the color differs,
         a button offers the opened color back (and saves it). */%>
    <% const color = it.player.preferred_color || '#5a3e2b'; %>
    <div class="form-group" data-signals="{color: '<%= color %>', openedColor: '<%= color %>'}">
      <label class="form-label" for="preferred_color">Preferred color</label>
      <div class="color-field autosave">
        <input type="color" id="preferred_color" name="preferred_color"
               value="<%= color %>" data-bind:color
               aria-describedby="color-hint"
               oninput="document.getElementById('preferred_color_text').value = this.value"
               data-on:change="@post('<%= detailsUrl %>?field=color', {contentType: 'form'})">
        <input class="form-control" type="text" id="preferred_color_text" aria-label="Color code"
               value="<%= color %>" style="flex:1"
               oninput="if (/^#[0-9a-f]{6}$/i.test(this.value)) { const c = document.getElementById('preferred_color'); c.value = this.value; c.dispatchEvent(new Event('input', { bubbles: true })); c.dispatchEvent(new Event('change', { bubbles: true })); }">
        <span id="save-color" class="autosave__mark" aria-hidden="true"></span>
      </div>
      <button type="button" class="btn btn--ghost btn--sm color-restore" style="display:none"
              data-show="$color.toLowerCase() !== $openedColor.toLowerCase()"
              data-on:click="const c = document.getElementById('preferred_color'); c.value = $openedColor; c.dispatchEvent(new Event('input', { bubbles: true })); c.dispatchEvent(new Event('change', { bubbles: true }))">
        <span class="color-restore__swatch" aria-hidden="true" style="background:<%= color %>"></span>
        Restore previous color (<%= color %>)
      </button>
      <span class="form-hint" id="color-hint">Used for your player chip and score sheet highlights.</span>
    </div>
    <noscript><button type="submit" class="btn btn--primary">Save name and color</button></noscript>
  </form>

  <%/* The picture is framed before it's stored, so it has its own save */%>
  <form action="/players/<%= it.player.id %>/picture" method="POST" enctype="multipart/form-data" novalidate style="margin-top:var(--space-6)">
    <fieldset class="form-group" style="border:0;padding:0;margin-inline:0">
      <legend class="form-label">Profile picture</legend>
      <div style="display:flex;align-items:center;gap:var(--space-3);margin-bottom:var(--space-3)">
        <%~ it.avatar(it.player.avatar_url, it.player.display_name, it.player.preferred_color, 'avatar--lg', it.player.avatar_url ? (isGuest ? `${it.player.display_name}'s current picture` : 'Your current profile picture') : '') %>
        <% if (it.player.avatar_url) { %>
        <button type="submit" form="remove-picture" class="btn btn--ghost btn--sm">Remove picture</button>
        <% } else { %>
        <span class="form-hint" style="margin:0"><%= isGuest ? 'No picture yet. Everyone sees their initial until one is added.' : 'No picture yet. Others see your initial until you add one.' %></span>
        <% } %>
      </div>
      <avatar-picker name="avatar" facing="<%= isGuest ? 'environment' : 'user' %>" aria-label="Upload, link or take a new profile picture"></avatar-picker>
      <span class="form-hint">JPEG, PNG, WebP, GIF or AVIF, up to 10 MB.</span>

      <%/* The cropper shows the picture being framed, so the picker's own thumbnails would repeat it */%>
      <style>avatar-picker .ap-preview { display: none !important; }</style>
      <div style="margin-top:var(--space-4)">
        <span class="form-label" style="display:block">Framing</span>
        <avatar-cropper name="avatar_crop"
          <% if (it.player.avatar_url) { %>src="<%= it.imgOriginal(it.player.avatar_url) %>" crop="<%= it.imgCrop(it.player.avatar_url) %>"<% } %>></avatar-cropper>
      </div>
    </fieldset>

    <div class="form-actions">
      <button type="submit" class="btn btn--primary">Save picture</button>
    </div>
  </form>

  <% if (it.player.avatar_url) { %>
  <form id="remove-picture" action="/players/<%= it.player.id %>/picture" method="POST" hidden
        data-confirm="Remove <%= isGuest ? `${it.player.display_name}'s` : 'your' %> picture? <%= isGuest ? 'Everyone will see their initial instead.' : 'Others will see your initial instead.' %>"
        data-confirm-title="Remove picture" data-confirm-label="Remove">
    <input type="hidden" name="remove_avatar" value="1">
  </form>
  <% } %>
  <div class="form-actions" style="margin-top:var(--space-6)">
    <a href="/players/<%= it.player.id %>" class="btn btn--secondary">Done</a>
  </div>
</div>
