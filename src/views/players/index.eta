<% layout('../layouts/base') %>
<%
const sections = [
  { id: 'members', title: 'Members', list: it.members, always: true,
    hint: 'People with an account in this group.' },
  { id: 'guests', title: 'Guests', list: it.guests, always: true,
    hint: it.guests.length
      ? 'People without an account, kept by the group so their games add up.'
      : 'No guests yet.' },
  { id: 'played', title: "People you've played with", list: it.played, always: false,
    hint: "They've played in a game with you but aren't members of this group. Invite them from the group page to add them." },
];
%>

<div class="page-header">
  <div class="page-header__text">
    <p class="page-header__eyebrow"><%= it.group.name %></p>
    <h1 class="page-header__title">Players</h1>
  </div>
</div>

<% sections.forEach(function(sec, si) { if (!sec.always && !sec.list.length) return; %>
<section aria-labelledby="<%= sec.id %>-heading" class="section"<% if (si) { %> style="margin-top:var(--space-6)"<% } %>>
  <div class="section-head">
    <h2 id="<%= sec.id %>-heading"><%= sec.title %></h2>
    <% if (sec.id === 'guests' && it.canManageGuests && sec.list.length) { %>
    <a href="/players/manage" class="btn btn--secondary btn--sm">Manage guests</a>
    <% } %>
  </div>
  <% if (sec.list.length) { %>
  <div class="card-grid">
    <% sec.list.forEach(function(p) { %>
    <a href="/players/<%= p.id %>" class="link-card<%= p.hidden_at ? ' link-card--muted' : '' %>">
      <span class="vt-box" data-vt style="--vt: player-<%= p.id %>"><%~ it.avatar(p.avatar_url, p.display_name, p.preferred_color) %></span>
      <span class="link-card__text">
        <span class="link-card__title"><%= p.display_name %><%= p.user_id === it.user.sub ? ' (you)' : '' %></span>
        <% if (p.hidden_at) { %>
        <span class="link-card__meta">Hidden from suggestions</span>
        <% } %>
      </span>
    </a>
    <% }) %>
  </div>
  <% } %>
  <p class="form-hint" style="margin-top:var(--space-2)">
    <%= sec.hint %>
    <% if (sec.id === 'members') { %><a href="/groups/<%= it.group.id %>">Invite more from the group page</a>.<% } %>
    <% if (sec.id === 'guests') { %>Add one by typing their name when you start a game.<% } %>
  </p>
</section>
<% }) %>
