<% layout('../layouts/base') %>

<div class="page-header">
  <div class="page-header__text">
  <a href="/players" class="page-header__eyebrow"><span aria-hidden="true">←</span> Players</a>
  <div style="display:flex;align-items:center;gap:var(--space-3)">
    <span class="vt-box" data-vt style="--vt: player-<%= it.player.id %>"><%~ it.avatar(it.player.avatar_url, it.player.display_name, it.player.preferred_color, 'avatar--lg') %></span>
    <div>
      <h1 class="page-header__title"><%= it.player.display_name %></h1>
      <% if (!it.player.user_id) { %><div style="font-size:var(--text-sm);color:var(--color-text-muted)"><span class="badge">Guest</span></div><% } %>
    </div>
  </div>
  </div>
  <% if (it.canEdit) { %>
  <div class="page-header__actions">
    <a href="/players/<%= it.player.id %>/edit" class="btn btn--secondary"><%= it.player.user_id ? 'Edit profile' : 'Edit guest' %></a>
  </div>
  <% } %>
</div>

<% if (it.claimed) { %>
<div class="flash flash--success" role="status">Done. Those games are on your record now.</div>
<% } %>

<% if (it.canEdit && !it.player.user_id) { %>
<section id="claim" class="card" aria-labelledby="claim-heading" style="margin-bottom:var(--space-4)">
  <div class="card__body" style="display:grid;gap:var(--space-2)">
    <h2 id="claim-heading" style="font-size:var(--text-base)">Does <%= it.player.display_name %> have an account?</h2>
    <p class="form-hint" style="margin:0">
      Share a link so <%= it.player.display_name %> can sign in or register and take these games as their own.
      They'll join this group as a Player. The link works once.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);align-items:center">
      <% if (it.claimUrl) { %>
      <qr-share url="<%= it.claimUrl %>" label="Show claim link" button-class="btn btn--secondary"
                heading="Claim <%= it.player.display_name %>'s games" hint="Scan with a phone camera, sign in or register, and these games become yours."></qr-share>
      <form action="/players/<%= it.player.id %>/claim-link/reset" method="POST" style="margin:0"
            data-confirm="Make a new link? The one you shared will stop working." data-confirm-title="New claim link" data-confirm-label="Make new link">
        <button type="submit" class="btn btn--ghost btn--sm">New link</button>
      </form>
      <% } else { %>
      <form action="/players/<%= it.player.id %>/claim-link" method="POST" style="margin:0">
        <button type="submit" class="btn btn--secondary">Invite <%= it.player.display_name %> to claim these games</button>
      </form>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<div class="stats-grid" style="margin-bottom:var(--space-6)" aria-label="Player statistics">
  <div class="stat-card">
    <div class="stat-card__value"><%= it.stats.games_played || 0 %></div>
    <div class="stat-card__label">Games played</div>
  </div>
  <div class="stat-card">
    <div class="stat-card__value"><%= it.stats.wins || 0 %></div>
    <div class="stat-card__label">Wins</div>
  </div>
  <div class="stat-card">
    <div class="stat-card__value"><%= it.stats.win_rate || 0 %>%</div>
    <div class="stat-card__label">Win rate</div>
  </div>
</div>

<section aria-labelledby="history-heading">
  <h2 id="history-heading" style="margin-bottom:var(--space-3)">Game history</h2>

  <% if (it.history.length === 0) { %>
  <div class="empty-state" style="padding:var(--space-4)">
    <p>No completed sessions yet.</p>
  </div>
  <% } else { %>
  <div class="session-list" role="list">
    <% it.history.forEach(function(entry) { %>
    <a class="session-card" role="listitem"
       href="/games/<%= entry.game_id %>/sessions/<%= entry.session_id %>"
       aria-label="<%= entry.game_name %> — <%= new Date(entry.started_at).toLocaleDateString() %>, rank <%= entry.rank %>">
      <% if (entry.image_url) { %>
      <img src="<%= it.imgUrl(entry.image_url) %>" alt="" class="avatar" style="border-radius:var(--radius-sm)" aria-hidden="true">
      <% } else { %>
      <div class="avatar" aria-hidden="true" style="border-radius:var(--radius-sm)">🎲</div>
      <% } %>
      <div style="flex:1">
        <div style="font-weight:600"><%= entry.game_name %></div>
        <div style="font-size:var(--text-xs);color:var(--color-text-muted)">
          <%= new Date(entry.started_at).toLocaleDateString() %>
          &bull; Score: <%= entry.total_score || 0 %>
        </div>
      </div>
      <% if (Number(entry.won) === 1) { %>
      <span class="badge badge--gold" aria-label="Winner">🏆 Winner</span>
      <% } else { %>
      <span style="font-size:var(--text-sm);color:var(--color-text-muted)">Rank #<%= entry.rank %></span>
      <% } %>
    </a>
    <% }) %>
  </div>
  <% } %>
</section>
