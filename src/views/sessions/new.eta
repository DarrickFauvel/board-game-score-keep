<% layout('../layouts/base') %>

<div style="max-width:48rem;margin:0 auto">
  <div class="page-header">
    <h1 class="page-header__title">New Session: <%= it.game.name %></h1>
    <a href="/games/<%= it.game.id %>" class="btn btn--secondary">Cancel</a>
  </div>

  <form action="/games/<%= it.game.id %>/sessions" method="POST" novalidate>

    <% if (it.game.teams_mode === 'none' || it.game.teams_mode === 'profiles') { %>
    <section aria-labelledby="players-heading">
      <h2 id="players-heading" style="margin-bottom:var(--space-3)">Players</h2>
      <div id="participant-list" style="display:flex;flex-direction:column;gap:var(--space-2)">
      </div>

      <div style="margin-top:var(--space-3)">
        <label class="form-label" for="player-search">Add a player</label>
        <div class="input-row">
          <input class="form-control" type="text" id="player-search"
                 placeholder="Search players…"
                 list="player-suggestions"
                 onkeydown="if(event.key==='Enter'){event.preventDefault();addPlayerFromSearch();}">
          <datalist id="player-suggestions">
            <% it.players.forEach(function(p) { %>
            <option value="<%= p.display_name %>" data-id="<%= p.id %>" data-color="<%= p.preferred_color || '' %>"></option>
            <% }) %>
          </datalist>
          <button type="button" class="btn btn--secondary" onclick="addPlayerFromSearch()">Add</button>
        </div>
      </div>

      <div style="margin-top:var(--space-2)">
        <p style="font-size:var(--text-sm);color:var(--color-text-muted)">Or add a guest player:</p>
        <div class="input-row" style="margin-top:var(--space-1)">
          <input class="form-control" type="text" id="guest-name" placeholder="Guest name" maxlength="60">
          <button type="button" class="btn btn--secondary" onclick="addGuest()">Add Guest</button>
        </div>
      </div>
    </section>
    <% } %>

    <% if (it.game.teams_mode === 'adhoc') { %>
    <section aria-labelledby="teams-heading">
      <h2 id="teams-heading" style="margin-bottom:var(--space-3)">Teams</h2>
      <div id="team-list" style="display:flex;flex-direction:column;gap:var(--space-2)">
        <div class="card" style="padding:var(--space-2)">
          <input class="form-control" type="text" name="display_name" placeholder="Team name (e.g. Red Team)" required>
          <input type="hidden" name="player_id" value="">
          <input type="hidden" name="color" value="">
        </div>
        <div class="card" style="padding:var(--space-2)">
          <input class="form-control" type="text" name="display_name" placeholder="Team name (e.g. Blue Team)" required>
          <input type="hidden" name="player_id" value="">
          <input type="hidden" name="color" value="">
        </div>
      </div>
      <button type="button" class="btn btn--secondary btn--sm" style="margin-top:var(--space-2)"
              onclick="addTeam()">+ Add Team</button>
    </section>
    <% } %>

    <% if (it.game.scoring_mode === 'tally') { %>
    <div class="form-group" style="margin-top:var(--space-4)">
      <label class="form-label" for="planned_rounds">Number of <%= it.units(it.game).rounds %></label>
      <input class="form-control form-control--narrow" type="number" inputmode="numeric" id="planned_rounds" name="planned_rounds"
             min="1" max="99" step="1" value="<%= it.game.suggested_rounds || '' %>" aria-describedby="planned_rounds-hint">
      <span class="form-hint" id="planned_rounds-hint">
        <% if (it.game.suggested_rounds) { %>The rules say <%= it.game.suggested_rounds %>. Change it for a shorter game, or clear it to play without a set end.<% } else { %>Optional. Leave blank to play without a set end.<% } %>
      </span>
    </div>
    <% } %>

    <div class="form-group" style="margin-top:var(--space-4)">
      <% const lowestWins = it.winRule(it.game).lowestWins %>
      <label class="form-label" for="target_score"><%= lowestWins ? 'Game ends at' : it.units(it.game).Points + ' to win' %></label>
      <input class="form-control form-control--narrow" type="number" inputmode="numeric" id="target_score" name="target_score"
             min="1" max="9999" step="1" value="<%= it.game.target_score || '' %>" aria-describedby="target_score-hint">
      <span class="form-hint" id="target_score-hint">
        <% if (lowestWins) { %>Optional. The game ends when someone reaches this many <%= it.units(it.game).points %>, and the lowest total wins.<% } else if (it.game.target_score) { %>The rules say first to <%= it.units(it.game).pointCount(Number(it.game.target_score)) %>. Change it for a shorter or longer game, or clear it to play without a target.<% } else { %>Optional. For "first to …" games; leave blank to play without a target.<% } %>
      </span>
    </div>

    <div class="form-actions" style="margin-top:var(--space-6)">
      <a href="/games/<%= it.game.id %>" class="btn btn--secondary">Cancel</a>
      <button type="submit" class="btn btn--primary">Start Session</button>
    </div>

  </form>
</div>

<script>
<%/* Only what the picker needs, with each picture already resolved; "<" escaped so a name can't close this script */%>
const playersData = <%~ JSON.stringify(it.players.map(p => ({
  id: p.id, display_name: p.display_name, preferred_color: p.preferred_color,
  avatar: p.avatar_url ? it.imgUrl(p.avatar_url) : '',
}))).replace(/</g, '\\u003c') %>;

function addPlayerFromSearch() {
  const search = document.getElementById('player-search');
  const val = search.value.trim();
  if (!val) return;
  // Ignore capitals and extra spaces, so "sam" still links to Sam and brings their picture
  const norm = (s) => s.trim().toLowerCase().replace(/\s+/g, ' ');
  const player = playersData.find(p => norm(p.display_name) === norm(val));
  addParticipantRow(player ? player.display_name : val, player?.id ?? '', player?.preferred_color ?? '', player?.avatar ?? '');
  search.value = '';
}

function addGuest() {
  const name = document.getElementById('guest-name').value.trim();
  if (!name) return;
  addParticipantRow(name, '', '');
  document.getElementById('guest-name').value = '';
}

/* Built with DOM calls, not an HTML string, so names show as typed and never run as markup */
function addParticipantRow(name, playerId, color, avatarSrc = '') {
  const el = (tag, props = {}) => Object.assign(document.createElement(tag), props);
  const hidden = (n, v) => el('input', { type: 'hidden', name: n, value: v });

  let pic;
  if (avatarSrc) {
    pic = el('img', { className: 'avatar', src: avatarSrc, alt: '' });
  } else {
    pic = el('span', { className: 'avatar', textContent: ([...name][0] ?? '?').toUpperCase() });
    pic.style.background = color || 'var(--color-surface)';
  }
  pic.setAttribute('aria-hidden', 'true');

  const remove = el('button', { type: 'button', className: 'btn btn--ghost btn--sm', textContent: '✕' });
  remove.setAttribute('aria-label', `Remove ${name}`);
  remove.addEventListener('click', () => card.remove());

  const row = el('div');
  row.style.cssText = 'display:flex;align-items:center;gap:var(--space-2);flex-wrap:wrap';
  const label = el('span', { textContent: name });
  label.style.cssText = 'font-weight:600;flex:1';
  row.append(pic, label, hidden('player_id', playerId), hidden('display_name', name), hidden('color', color), remove);

  const card = el('div', { className: 'card' });
  card.style.padding = 'var(--space-2)';
  card.append(row);
  document.getElementById('participant-list').appendChild(card);
}

function addTeam() {
  const list = document.getElementById('team-list');
  const div = document.createElement('div');
  div.className = 'card';
  div.style.padding = 'var(--space-2)';
  div.innerHTML = `
    <input class="form-control" type="text" name="display_name" placeholder="Team name" required>
    <input type="hidden" name="player_id" value="">
    <input type="hidden" name="color" value="">`;
  list.appendChild(div);
}
</script>
