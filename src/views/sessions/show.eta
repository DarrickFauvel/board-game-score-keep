<% layout('../layouts/base') %>
<%
// Same rule as the scoreboard trophy: someone finished on a total above 0
const sessionTotals = {};
for (const s of it.scores) sessionTotals[s.participant_id] = (sessionTotals[s.participant_id] || 0) + (s.value || 0);
const hasWinner = Math.max(0, ...Object.values(sessionTotals)) > 0;
%>

<div class="page-header">
  <div>
    <h1 class="page-header__title"><%= it.game.name %></h1>
    <div style="font-size:var(--text-xs);color:var(--color-text-muted)">
      <%= new Date(it.session.started_at).toLocaleDateString('en-US', {weekday:'long', month:'long', day:'numeric', year:'numeric'}) %>
    </div>
  </div>
  <div style="display:flex;gap:var(--space-2);align-items:center;flex-wrap:wrap">
    <span class="badge badge--<%= it.session.status === 'active' ? 'active' : 'complete' %>"><%= it.session.status %></span>
    <% if (it.session.status === 'active') { %>
    <form action="/games/<%= it.game.id %>/sessions/<%= it.session.id %>/complete" method="POST" style="margin:0"
          data-confirm="Mark this session as complete? Scores will be locked."
          data-confirm-title="Complete Session"
          data-confirm-label="Complete"
          data-celebrate>
      <button type="submit" class="btn btn--gold">Complete Session</button>
    </form>
    <% } else if (hasWinner) { %>
    <button type="button" class="btn btn--gold" data-celebrate-url="/games/<%= it.game.id %>/sessions/<%= it.session.id %>/celebration">🎉 Celebrate again</button>
    <% } %>
    <% if (it.game.rules_url) { %>
    <a href="<%= it.game.rules_url %>" class="btn btn--secondary" target="_blank" rel="noopener noreferrer external">Rules<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
    <% } %>
    <a href="/games/<%= it.game.id %>" class="btn btn--secondary">Back</a>
  </div>
</div>

<%
const scoringMode = it.game.scoring_mode;
const scoreMap = {};
for (const entry of it.scores) {
  const key = entry.participant_id + '_' + (entry.category_id || 'total') + '_' + (entry.round ?? 0);
  scoreMap[key] = entry.value;
}
const totals = {};
for (const p of it.participants) {
  totals[p.id] = it.scores.filter(s => s.participant_id === p.id).reduce((sum, s) => sum + (s.value || 0), 0);
}
const maxTotal = Math.max(...Object.values(totals), 0);
%>

<%/* Live sync while the session is active: the stream patches two signals,
     scoresVersion (scores changed on some device) and sessionStatus, and
     live-scores.js refreshes the scoreboard or celebrates in response. */%>
<% const isLive = it.session.status === 'active'; %>
<div id="scoreboard-section"
     data-scoreboard-url="/games/<%= it.game.id %>/sessions/<%= it.session.id %>/scoreboard"
     data-celebration-url="/games/<%= it.game.id %>/sessions/<%= it.session.id %>/celebration"
     <% if (isLive) { %>
     data-signals='{"scoresVersion":0,"sessionStatus":"active"}'
     data-init="@get('/sse/sessions/<%= it.session.id %>/scores')"
     <%/* Both signals are read up front: Datastar re-runs an effect only for
          signals it read, and on the first run live-scores.js may not have
          loaded yet, which would short-circuit the call and its arguments */%>
     data-effect="$scoresVersion; $sessionStatus; window.liveScores?.update($scoresVersion, $sessionStatus)"
     <% } %>>

  <%/* Not aria-live: a refresh replaces the whole board; live-scores.js
       announces a short "Scores updated" instead */%>
  <div id="score-rows" role="region" aria-label="Scores">

    <% if (scoringMode === 'tally') { %>
    <%~ include('../partials/scoreboard-tally', it) %>
    <% } else if (scoringMode === 'categories') { %>
    <%~ include('../partials/scoreboard-categories', it) %>
    <% } else { %>
    <%~ include('../partials/scoreboard-final', it) %>
    <% } %>

  </div>
</div>

<section aria-labelledby="note-heading" class="section" style="margin-top:var(--space-6)">
  <h2 id="note-heading">Session Notes</h2>
  <div class="card">
    <div class="card__body">
      <form action="/games/<%= it.game.id %>/sessions/<%= it.session.id %>/note" method="POST">
        <div class="form-group">
          <label class="form-label" for="note">
            How did it go?
            <voice-input target="#note" aria-label="Use voice to dictate note"></voice-input>
          </label>
          <textarea class="form-control" id="note" name="note" rows="4"
                    placeholder="Memorable moments, house rules, who won dramatically…"><%= it.session.note || '' %></textarea>
        </div>
        <button type="submit" class="btn btn--primary">Save Note</button>
      </form>
    </div>
  </div>
</section>

<section aria-labelledby="photos-heading" class="section" style="margin-top:var(--space-4)">
  <h2 id="photos-heading">Photos</h2>

  <%/* Uploads go one at a time in the background, so photos can be taken back to back.
       The inner form is the no-JS fallback; photo-gallery replaces its controls. */%>
  <photo-gallery action="/games/<%= it.game.id %>/sessions/<%= it.session.id %>/photos">
    <form class="photo-gallery__fallback" action="/games/<%= it.game.id %>/sessions/<%= it.session.id %>/photos" method="POST" enctype="multipart/form-data">
      <label class="form-label" for="photos-input">Add photos</label>
      <input id="photos-input" type="file" name="photos" accept="image/*" multiple>
      <button type="submit" class="btn btn--primary" style="margin-top:var(--space-2)">Upload</button>
    </form>

    <ul class="photo-grid" role="list" data-photo-grid>
      <% for (const photo of it.photos) {
         const tagged = it.participants.filter(p => photo.participant_ids.includes(p.id));
      %>
      <li class="photo-tile" id="photo-<%= photo.id %>"
          data-photo-id="<%= photo.id %>"
          data-caption="<%= photo.caption || '' %>"
          data-participants="<%= photo.participant_ids.join(',') %>">
        <button type="button" class="photo-tile__open" data-photo-edit
                aria-label="Edit photo<%= photo.caption ? ': ' + photo.caption : '' %>">
          <img src="<%= it.imgUrl(photo.photo_url) %>" alt="<%= photo.caption || 'Session photo' %>" loading="lazy">
        </button>
        <% if (photo.caption || tagged.length) { %>
        <div class="photo-tile__details">
          <% if (photo.caption) { %><p class="photo-tile__caption"><%= photo.caption %></p><% } %>
          <% if (tagged.length) { %>
          <p class="photo-tile__people"><span class="visually-hidden">Playing: </span><%= tagged.map(p => p.display_name).join(', ') %></p>
          <% } %>
        </div>
        <% } %>
      </li>
      <% } %>
    </ul>

    <% if (it.photos.length === 0) { %>
    <p class="form-hint" data-photo-empty>No photos yet. Snap a few as you play.</p>
    <% } %>

    <dialog class="photo-dialog" aria-labelledby="photo-dialog-title">
      <form method="POST" class="photo-dialog__form" data-photo-form>
        <h3 id="photo-dialog-title" class="photo-dialog__title">Edit photo</h3>
        <img class="photo-dialog__img" alt="">
        <div class="form-group">
          <label class="form-label" for="photo-caption">Caption</label>
          <textarea class="form-control" id="photo-caption" name="caption" rows="2" maxlength="500"
                    placeholder="What was happening?"></textarea>
        </div>
        <fieldset class="form-group photo-dialog__people">
          <legend class="form-label">Who was playing?</legend>
          <div class="chip-options">
            <% it.participants.forEach(function(p) { %>
            <label class="chip-option">
              <input type="checkbox" name="participant_ids" value="<%= p.id %>">
              <span><%= p.display_name %></span>
            </label>
            <% }) %>
          </div>
        </fieldset>
        <div class="form-actions">
          <button type="button" class="btn btn--secondary" data-photo-cancel>Cancel</button>
          <button type="submit" class="btn btn--primary">Save</button>
        </div>
      </form>
      <form method="POST" class="photo-dialog__delete" data-photo-delete
            data-confirm="Remove this photo?"
            data-confirm-title="Delete Photo"
            data-confirm-label="Delete">
        <button type="submit" class="btn btn--ghost">Delete photo</button>
      </form>
    </dialog>
  </photo-gallery>
</section>

<fieldset style="border:1px solid var(--color-danger);border-radius:var(--radius-md);padding:var(--space-3);margin-top:var(--space-4)">
  <legend style="color:var(--color-danger);font-weight:600;padding:0 var(--space-1)">Danger Zone</legend>
  <p style="font-size:var(--text-sm);color:var(--color-text-muted);margin-bottom:var(--space-2)">Deleting this session will permanently remove all its scores.</p>
  <form action="/games/<%= it.game.id %>/sessions/<%= it.session.id %>/delete" method="POST" style="margin:0"
        data-confirm="Delete this session and all its scores? This cannot be undone."
        data-confirm-title="Delete Session"
        data-confirm-label="Delete">
    <button type="submit" class="btn btn--danger">Delete Session</button>
  </form>
</fieldset>
