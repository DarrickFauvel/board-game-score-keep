<% layout('../layouts/base') %>

<div class="page-header">
  <div class="page-header__text">
    <% if (it.group) { %><p class="page-header__eyebrow"><%= it.group.name %></p><% } %>
    <h1 class="page-header__title">Standings</h1>
  </div>
</div>

<% if (it.games.length > 1) { %>
<nav class="tab-bar" aria-label="Filter standings by game">
  <a class="tab-bar__item" href="/standings" <%~ !it.selectedGame ? 'aria-current="page"' : '' %>>All games</a>
  <% it.games.forEach(function(game) { %>
  <a class="tab-bar__item" href="/standings?game=<%= game.id %>" <%~ it.selectedGame && it.selectedGame.id === game.id ? 'aria-current="page"' : '' %>><%= game.name %></a>
  <% }) %>
</nav>
<% } %>

<% if (it.standings.length === 0) { %>
<div class="empty-state">
  <span class="empty-state__icon"><%~ it.icon('trophy') %></span>
  <h2 class="empty-state__title">No standings yet</h2>
  <p>Complete a session with two or more players<%= it.selectedGame ? ' of ' + it.selectedGame.name : '' %> and the rankings appear here.</p>
</div>
<% } else { %>
<p class="leaderboard__summary">
  <%= it.selectedGame ? it.selectedGame.name + ' · ' : '' %><%= it.sessionCount %> completed session<%= it.sessionCount !== 1 ? 's' : '' %>.
  Ranked by wins, then win rate; ties share a rank.
</p>

<%/* A table from tablets up; on phones each row folds into a card (rank,
     player and wins on top, the other numbers under). The leader's row has
     the gold wash. */%>
<% const g = it.selectedGame %>
<div class="data-table-wrap">
  <table class="data-table standings-table">
    <caption class="visually-hidden">Standings<%= g ? ' for ' + g.name : '' %>, ranked by wins</caption>
    <thead>
      <tr>
        <th scope="col" class="data-table__rank">Rank</th>
        <th scope="col">Player</th>
        <th scope="col" class="data-table__num">Wins</th>
        <th scope="col" class="data-table__num">Played</th>
        <th scope="col" class="data-table__num">Win rate</th>
        <th scope="col" class="data-table__num">Avg finish</th>
        <% if (g) { %>
        <th scope="col" class="data-table__num">Avg score</th>
        <th scope="col" class="data-table__num">Best</th>
        <% } %>
      </tr>
    </thead>
    <tbody>
      <% it.standings.forEach(function(s) { %>
      <tr class="<%= s.rank === 1 ? 'data-table__row--lead' : '' %>">
        <td class="data-table__rank"><span class="standings-table__rank standings-table__rank--<%= s.rank %>"><%= s.rank %></span></td>
        <th scope="row" class="standings-table__player">
          <%~ it.avatar(s.avatarUrl, s.name, s.color, 'avatar--sm') %>
          <% if (s.playerId) { %><a href="/players/<%= s.playerId %>"><%= s.name %></a><% } else { %><span><%= s.name %></span><% } %>
        </th>
        <td class="data-table__num standings-table__wins" data-label="<%= s.wins === 1 ? 'win' : 'wins' %>"><strong><%= s.wins %></strong></td>
        <td class="data-table__num" data-label="played"><%= s.played %></td>
        <td class="data-table__num" data-label="wins"><%= s.winRate %>%</td>
        <td class="data-table__num" data-label="avg finish"><%= s.avgFinish %></td>
        <% if (g) { %>
        <td class="data-table__num" data-label="avg score"><%= s.avgScore %></td>
        <td class="data-table__num" data-label="best"><%= s.bestScore %></td>
        <% } %>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<script>
  // Keep the selected game's tab visible when the filter bar scrolls sideways
  document.querySelector('.tab-bar [aria-current="page"]')?.scrollIntoView({ inline: 'center', block: 'nearest' });
</script>
